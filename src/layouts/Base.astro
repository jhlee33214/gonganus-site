---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; image?: string; jsonLd?: object[]; }
// head 슬롯: 페이지별 preload 등을 넣는다
const { title, description, image, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <Seo title={title} description={description} image={image} jsonLd={jsonLd} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Regular.subset.88.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Regular.subset.89.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Regular.subset.90.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Regular.subset.91.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Medium.subset.88.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Medium.subset.89.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Medium.subset.90.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/pretendard/Pretendard-Medium.subset.91.woff2" />
    <link rel="stylesheet" href="/fonts/pretendard.css" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
