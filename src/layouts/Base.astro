---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
interface Props { title: string; description: string; image?: string; jsonLd?: object[]; }
const { title, description, image, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <Seo title={title} description={description} image={image} jsonLd={jsonLd} />
    <ClientRouter />
  </head>
  <body>
    <Intro />
    <Header />
    <main><slot /></main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
