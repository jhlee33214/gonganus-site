---
import { siteConfig, nav } from '../site.config';
import Logo from '../assets/logo.svg';
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${siteConfig.name} 홈`}><Logo class="logo" /></a>
    <nav class="nav" id="nav" aria-label="주 메뉴">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <button class="toggle" id="toggle" aria-expanded="false" aria-controls="nav" aria-label="메뉴 열기">
      <span></span><span></span>
    </button>
  </div>
</header>
<script>
  const t = document.getElementById('toggle')!;
  const n = document.getElementById('nav')!;
  t.addEventListener('click', () => {
    const open = n.classList.toggle('open');
    t.setAttribute('aria-expanded', String(open));
    t.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>
<style>
  .header { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand { display: block; line-height: 0; }
  .logo { height: 30px; width: auto; }
  .nav { display: flex; gap: 32px; font-size: 15px; font-weight: 500; letter-spacing: .01em; }
  .nav a[aria-current] { text-decoration: underline; text-underline-offset: 6px; }
  .toggle { display: none; width: 44px; height: 44px; margin-right: -10px; border: 0; background: none; cursor: pointer; flex-direction: column; justify-content: center; gap: 7px; }
  .toggle span { display: block; height: 1.5px; width: 22px; margin: 0 auto; background: var(--fg); transition: transform .25s; }
  @media (max-width: 768px) {
    .toggle { display: flex; }
    .nav { position: fixed; inset: 72px 0 0 0; background: var(--bg); flex-direction: column; align-items: center; justify-content: center; gap: 28px; font-size: 24px; transform: translateY(-110%); transition: transform .3s ease; }
    .nav.open { transform: none; }
    .toggle[aria-expanded="true"] span:first-child { transform: translateY(4.25px) rotate(45deg); }
    .toggle[aria-expanded="true"] span:last-child { transform: translateY(-4.25px) rotate(-45deg); }
  }
</style>
