---
import { siteConfig } from '../site.config';
interface Props { title?: string; body?: string; }
const { title = '촬영을 계획 중이신가요?', body = '공간 종류와 일정, 필요한 결과물을 알려주시면 하루 안에 견적을 보내드립니다. 카카오톡 채널이 가장 빠릅니다.' } = Astro.props;
---
<section class="section">
  <div class="container cta">
    <h2>{title}</h2>
    <p class="lead muted">{body}</p>
    <div class="actions">
      <a class="btn primary lg" href={siteConfig.kakao} target="_blank" rel="noopener">카카오톡으로 문의하기</a>
      <a class="btn lg" href={`mailto:${siteConfig.email}`}>이메일 보내기</a>
    </div>
  </div>
</section>
<style>
  .cta { display: grid; gap: 20px; padding: clamp(40px, 6vw, 80px) 0; border-top: 1px solid var(--line); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
