---
import { siteConfig } from '../site.config';
interface Props { title?: string; body?: string; }
const { title = '다음 촬영을 계획 중이라면', body = '공간 종류와 일정만 알려주세요.\n빠른 시간 안에 견적을 드립니다.' } = Astro.props;
---
<section class="cta-wrap">
  <div class="container cta" data-reveal>
    <h2>{title}</h2>
    <p class="lead muted" style="white-space: pre-line">{body}</p>
    <div class="actions">
      <a class="btn primary lg" href={siteConfig.kakao} target="_blank" rel="noopener">카카오톡 채널 ↗</a>
      <a class="btn lg" href={`mailto:${siteConfig.email}`}>이메일</a>
    </div>
  </div>
</section>
<style>
  .cta-wrap { padding: 0 0 clamp(64px, 9vw, 140px); }
  .cta { display: grid; gap: 18px; padding-top: clamp(48px, 6vw, 88px); border-top: 1px solid var(--line); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
</style>
