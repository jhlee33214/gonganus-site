---
// 첫 방문 인트로: 로고의 원이 그려지고 글자가 떠오른 뒤 화면이 위로 걷힌다. 세션당 1회, 모션 줄이기 설정 시 생략.
import Logo from '../assets/logo-intro.svg';
---
<div id="intro" aria-hidden="true">
  <div class="intro-inner"><Logo class="intro-logo" /></div>
</div>
<script is:inline>
  (function () {
    var skip = false;
    try { skip = sessionStorage.getItem('gonganus-intro') === '1'; } catch (e) {}
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) skip = true;
    var el = document.getElementById('intro');
    if (skip) { el && el.remove(); document.addEventListener('astro:before-swap', function (e) { var n = e.newDocument.getElementById('intro'); if (n) n.remove(); }); return; }
    document.documentElement.classList.add('intro-on');
    try { sessionStorage.setItem('gonganus-intro', '1'); } catch (e) {}
    setTimeout(function () { el && el.remove(); document.documentElement.classList.remove('intro-on'); }, 2600);
    document.addEventListener('astro:before-swap', function (e) { var n = e.newDocument.getElementById('intro'); if (n) n.remove(); });
  })();
</script>
<style is:global>
  #intro { position: fixed; inset: 0; z-index: 100; background: #0c0c0c; display: grid; place-items: center; animation: intro-out .9s cubic-bezier(.76,0,.24,1) 1.6s both; pointer-events: none; }
  @keyframes intro-out { to { clip-path: inset(0 0 100% 0); } }
  .intro-inner { animation: intro-lift .9s cubic-bezier(.76,0,.24,1) 1.6s both; }
  @keyframes intro-lift { to { transform: translateY(-40px); opacity: 0; } }
  .intro-logo { width: min(46vw, 260px); height: auto; filter: invert(1); }
  .intro-logo .ring { stroke-dasharray: 1; stroke-dashoffset: 1; animation: intro-ring 1.2s cubic-bezier(.22,1,.36,1) .15s forwards; }
  .intro-logo .r2 { animation-delay: .35s; }
  @keyframes intro-ring { to { stroke-dashoffset: 0; } }
  .intro-logo .word { opacity: 0; transform: translateY(8px); animation: intro-word .9s cubic-bezier(.22,1,.36,1) .7s forwards; }
  @keyframes intro-word { to { opacity: 1; transform: none; } }
  /* 인트로 중에는 히어로 등장 애니메이션을 인트로 끝난 뒤로 미룬다 */
  html.intro-on .line > span { animation-delay: 2.05s !important; }
  html.intro-on .line:nth-child(2) > span { animation-delay: 2.18s !important; }
  html.intro-on .hero-eyebrow { animation-delay: 2.3s !important; }
  html.intro-on .hero-row { animation-delay: 2.45s !important; }
  html.intro-on .hero-caption { animation-delay: 2.7s !important; }
  html.intro-on .hero-media img { animation-delay: 1.9s !important; }
</style>
