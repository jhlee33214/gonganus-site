---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Cta from '../../components/Cta.astro';
import { getAllWork, CATEGORIES, categoryUrl } from '../../lib/work';
const works = await getAllWork();
const cats = Object.entries(CATEGORIES) as [keyof typeof CATEGORIES, { label: string }][];
---
<Base title="포트폴리오 — 공간어스 인테리어 사진·영상 촬영" description={`공간어스가 촬영한 카페·쇼룸·숙박·주거 공간 ${works.length}곳의 사진 포트폴리오입니다. 인테리어 회사와 브랜드를 위한 공간 촬영 사례를 분류별로 보실 수 있습니다.`}>
  <section class="section">
    <div class="container">
      <h1>Work</h1>
      <nav class="cats" aria-label="분류">
        <a href="/work/" aria-current="page">전체 <span class="muted">{works.length}</span></a>
        {cats.map(([k, c]) => { const n = works.filter((w) => w.data.category === k).length; return n ? <a href={categoryUrl(k)}>{c.label} <span class="muted">{n}</span></a> : null; })}
      </nav>
      <WorkGrid works={works} />
    </div>
  </section>
  <Cta />
</Base>
<style is:global>
  .cats { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 24px 0 40px; font-size: 15px; font-weight: 500; }
  .cats a[aria-current] { text-decoration: underline; text-underline-offset: 6px; }
</style>
