---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Sentences from '../../components/Sentences.astro';
import { siteConfig } from '../../site.config';
import { getAllWork, getAdjacent, getProjectImages, CATEGORIES, categoryUrl, workUrl, getCover } from '../../lib/work';
export async function getStaticPaths() {
  return (await getAllWork()).map((w) => ({ params: { slug: w.id }, props: { work: w } }));
}
const { work } = Astro.props;
const d = work.data;
const images = getProjectImages(work.id);
const cover = getCover(work.id, d.cover);
const rest = images.filter((i) => i.image !== cover);
const { prev, next } = await getAdjacent(work.id);
const cat = CATEGORIES[d.category];
// 뷰어용 이미지 URL(큰 화면 1920px, 필름스트립 240px)
const full = await Promise.all(images.map((i) => getImage({ src: i.image, width: 1920, format: 'webp', quality: 82 })));
const strip = await Promise.all(images.map((i) => getImage({ src: i.image, width: 240, height: 180, fit: 'cover', format: 'webp', quality: 70 })));
const viewer = images.map((i, n) => ({ src: full[n].src, w: i.image.width, h: i.image.height, thumb: strip[n].src }));
const title = `${d.title} ${cat.label} 촬영 — 공간어스`;
const description = `${d.summary} ${d.year}년 ${d.location ? d.location + ' ' : ''}${cat.label} 공간 사진 ${images.length}장.`;
const articleBody = d.note ? `${d.summary} ${d.note}` : d.summary;
const ogImage = `/work/${work.id}/og.jpg`;
const jsonLd = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Work', item: `${siteConfig.url}/work/` },
    { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(categoryUrl(d.category), siteConfig.url).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
}, {
  '@type': 'ImageGallery',
  name: `${d.title} ${cat.label} 촬영`,
  description: articleBody,
  url: new URL(workUrl(work), siteConfig.url).href,
  datePublished: `${d.year}-01-01`,
  author: { '@id': `${siteConfig.url}/#business` },
  numberOfItems: images.length,
}];
---
<Base title={title} description={description} image={ogImage} jsonLd={jsonLd}>
  <article>
    <div class="cover" transition:name={`cover-${work.id}`}>
      <Image src={cover} alt={`${d.title} 공간 사진 1`} widths={[960, 1440, 1920, 2560]} sizes="100vw" width={2560} height={Math.round(2560 * cover.height / cover.width)} loading="eager" fetchpriority="high" />
    </div>
    <div class="container layout">
      <aside class="side">
        <div class="sticky" data-reveal>
          <p class="eyebrow"><a href={categoryUrl(d.category)}>{cat.label}</a></p>
          <h1>{d.title}</h1>
          <p class="summary muted"><Sentences text={d.summary} /></p>
          {d.note && <div class="note"><p class="eyebrow">Shooting note</p><p><Sentences text={d.note} /></p></div>}
          <dl class="facts">
            <div><dt>Year</dt><dd>{d.year}</dd></div>
            {d.location && <div><dt>Location</dt><dd>{d.location}</dd></div>}
            <div><dt>Photos</dt><dd>{images.length}</dd></div>
          </dl>
        </div>
      </aside>
      <div class="grid">
        {images.map((img, n) => (
          <button class="cell" type="button" data-open={n} aria-label={`${d.title} 사진 ${n + 1} 크게 보기`} data-reveal="wipe">
            <Image src={img.image} alt={`${d.title} 공간 사진 ${n + 1}`} widths={[480, 960]} sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 22vw" width={960} height={720} loading={n < 6 ? 'eager' : 'lazy'} />
            <span class="idx">{String(n + 1).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="viewer" id="viewer" aria-hidden="true" role="dialog" aria-label={`${d.title} 사진 보기`} data-images={JSON.stringify(viewer)}>
      <div class="v-top">
        <span class="v-title">{d.title}</span>
        <span class="v-count"><b id="v-cur">01</b> / {String(images.length).padStart(2, '0')}</span>
        <button class="v-close" type="button" aria-label="닫기">×</button>
      </div>
      <div class="v-stage" id="v-stage">
        <img class="v-img a" alt="" />
        <img class="v-img b" alt="" />
        <button class="v-nav prev" type="button" aria-label="이전">←</button>
        <button class="v-nav next" type="button" aria-label="다음">→</button>
      </div>
      <div class="v-strip" id="v-strip">
        {viewer.map((v, n) => <button type="button" data-go={n} aria-label={`사진 ${n + 1}`}><img src={v.thumb} alt="" loading="lazy" width="120" height="90" /></button>)}
      </div>
    </div>
    <nav class="container adjacent" aria-label="다른 프로젝트" data-reveal>
      {prev ? <a href={workUrl(prev)} class="adj"><span class="muted">Prev</span><strong>{prev.data.title}</strong></a> : <span />}
      <a href="/work/" class="link">All Work</a>
      {next ? <a href={workUrl(next)} class="adj right"><span class="muted">Next</span><strong>{next.data.title}</strong></a> : <span />}
    </nav>
  </article>
  <Cta title={`${cat.label} 공간 촬영이 필요하다면`} />
</Base>
<script>
  function initViewer() {
    const v = document.getElementById('viewer');
    if (!v || v.dataset.bound) return;
    v.dataset.bound = '1';
    const imgs: { src: string; w: number; h: number }[] = JSON.parse(v.dataset.images || '[]');
    const layers = [v.querySelector('.v-img.a') as HTMLImageElement, v.querySelector('.v-img.b') as HTMLImageElement];
    const cur = document.getElementById('v-cur')!, strip = document.getElementById('v-strip')!;
    let i = 0, top = 0, open = false;
    const lenis = () => (window as any).__lenis;
    const preload = (n: number) => { const k = (n + imgs.length) % imgs.length; const im = new Image(); im.src = imgs[k].src; };
    function show(n: number, dir = 0) {
      i = (n + imgs.length) % imgs.length;
      const next = layers[1 - top], prev = layers[top];
      next.src = imgs[i].src;
      next.style.setProperty('--dx', dir === 0 ? '0' : dir > 0 ? '24px' : '-24px');
      next.classList.add('on'); prev.classList.remove('on');
      top = 1 - top;
      cur.textContent = String(i + 1).padStart(2, '0');
      strip.querySelectorAll('button').forEach((b, k) => b.classList.toggle('on', k === i));
      strip.querySelector('button.on')?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      preload(i + 1); preload(i - 1);
    }
    function openAt(n: number) {
      open = true; v.classList.add('open'); v.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; lenis()?.stop();
      show(n);
    }
    function close() {
      open = false; v.classList.remove('open'); v.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = ''; lenis()?.start();
    }
    document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => openAt(Number(b.dataset.open))));
    strip.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go))));
    v.querySelector('.v-close')!.addEventListener('click', close);
    v.querySelector('.prev')!.addEventListener('click', () => show(i - 1, -1));
    v.querySelector('.next')!.addEventListener('click', () => show(i + 1, 1));
    v.querySelector('#v-stage')!.addEventListener('click', (e) => { if ((e.target as HTMLElement).id === 'v-stage') close(); });
    document.addEventListener('keydown', (e) => { if (!open) return; if (e.key === 'Escape') close(); if (e.key === 'ArrowRight') show(i + 1, 1); if (e.key === 'ArrowLeft') show(i - 1, -1); });
    let x0 = 0, y0 = 0;
    v.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    v.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1); }, { passive: true });
    document.addEventListener('astro:before-swap', () => { if (open) close(); });
  }
  document.addEventListener('astro:page-load', initViewer);
</script>
<style>
  .cover { aspect-ratio: 16 / 9; max-height: 92vh; }
  .cover img { width: 100%; height: 100%; }
  .layout { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding-top: clamp(32px, 4vw, 56px); padding-bottom: clamp(48px, 6vw, 96px); align-items: start; }
  .sticky { position: sticky; top: 96px; display: grid; gap: 18px; }
  .eyebrow a { border-bottom: 1px solid currentColor; }
  h1 { font-size: clamp(30px, 3.4vw, 52px); }
  .summary { font-size: 16px; max-width: 30em; }
  .note { border-top: 1px solid var(--line); padding-top: 18px; font-size: 15px; line-height: 1.8; max-width: 32em; }
  .note .eyebrow { margin-bottom: 10px; }
  .facts { display: grid; gap: 10px; margin: 8px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 14px; }
  .facts div { display: flex; justify-content: space-between; gap: 16px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 500; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .cell { position: relative; display: block; padding: 0; border: 0; background: var(--soft); aspect-ratio: 4 / 3; overflow: hidden; cursor: zoom-in; }
  .cell img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); will-change: transform; }
  .cell:hover img { transform: scale(1.025); }
  .cell .idx { position: absolute; left: 10px; bottom: 8px; font-size: 11px; letter-spacing: .06em; color: #fff; opacity: 0; transition: opacity .4s var(--ease); text-shadow: 0 1px 2px rgba(0,0,0,.4); }
  .cell:hover .idx { opacity: .9; }
  .cover { overflow: hidden; background: var(--soft); }
  /* 전체화면 뷰어 */
  .viewer { position: fixed; inset: 0; z-index: 90; background: rgba(8,8,8,.97); color: #f2f2f0; display: grid; grid-template-rows: auto 1fr auto; opacity: 0; visibility: hidden; transition: opacity .4s var(--ease), visibility 0s .4s; }
  .viewer.open { opacity: 1; visibility: visible; transition: opacity .4s var(--ease), visibility 0s; }
  .v-top { display: flex; align-items: center; gap: 20px; padding: 18px var(--gutter); font-size: 13px; }
  .v-title { font-weight: 500; }
  .v-count { color: #9a9a96; font-variant-numeric: tabular-nums; margin-left: auto; }
  .v-count b { color: #f2f2f0; font-weight: 500; }
  .v-close { border: 0; background: none; color: #f2f2f0; font-size: 28px; line-height: 1; cursor: pointer; padding: 4px 8px; }
  .v-stage { position: relative; overflow: hidden; }
  .v-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 0 clamp(16px, 6vw, 96px); opacity: 0; transform: translateX(var(--dx, 0)) scale(.985); transition: opacity .55s var(--ease), transform .7s var(--ease); pointer-events: none; }
  .v-img.on { opacity: 1; transform: none; }
  .v-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; border-radius: 50%; border: 1px solid rgba(255,255,255,.22); background: rgba(12,12,12,.5); color: #fff; font-size: 18px; cursor: pointer; transition: background .3s, border-color .3s; }
  .v-nav:hover { background: #f2f2f0; color: #0c0c0c; border-color: #f2f2f0; }
  .v-nav.prev { left: 20px; } .v-nav.next { right: 20px; }
  .v-strip { display: flex; gap: 6px; padding: 14px var(--gutter) 18px; overflow-x: auto; scrollbar-width: none; }
  .v-strip::-webkit-scrollbar { display: none; }
  .v-strip button { flex: 0 0 auto; padding: 0; border: 0; background: none; opacity: .4; transition: opacity .3s; cursor: pointer; }
  .v-strip button.on, .v-strip button:hover { opacity: 1; }
  .v-strip img { width: 72px; height: 54px; object-fit: cover; display: block; }
  .adjacent { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-top: 40px; padding-bottom: 56px; border-top: 1px solid var(--line); }
  .adj { display: grid; gap: 4px; font-size: 13px; }
  .adj strong { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
  .right { text-align: right; }
  @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; gap: 32px; } .sticky { position: static; } }
  @media (max-width: 768px) { .v-nav { display: none; } .v-img { padding: 0; } .v-strip img { width: 56px; height: 42px; } }
  @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } .cover { aspect-ratio: 4 / 5; } }
</style>
