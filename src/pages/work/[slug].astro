---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Sentences from '../../components/Sentences.astro';
import { siteConfig } from '../../site.config';
import { getAllWork, getAdjacent, getProjectImages, CATEGORIES, categoryUrl, workUrl, getCover } from '../../lib/work';
export async function getStaticPaths() {
  return (await getAllWork()).map((w) => ({ params: { slug: w.id }, props: { work: w } }));
}
const { work } = Astro.props;
const d = work.data;
const images = getProjectImages(work.id);
const cover = getCover(work.id, d.cover);
const rest = images.filter((i) => i.image !== cover);
const { prev, next } = await getAdjacent(work.id);
const cat = CATEGORIES[d.category];
// 에디토리얼 리듬: 풀폭 → 두 장 나란히 → 오른쪽으로 치우친 한 장 → 풀폭 → 두 장 → 왼쪽으로 치우친 한 장 … 반복
type Kind = 'wide' | 'pair' | 'right' | 'left';
type Row = { kind: Kind; items: typeof images };
const pattern: Kind[] = ['wide', 'pair', 'right', 'wide', 'pair', 'left'];
const rows: Row[] = [];
let pi = 0;
for (let i = 0; i < rest.length; ) {
  const kind = pattern[pi % pattern.length]; pi++;
  if (kind === 'pair') { rows.push({ kind, items: rest.slice(i, i + 2) }); i += 2; }
  else { rows.push({ kind, items: [rest[i]] }); i += 1; }
}
const title = `${d.title} ${cat.label} 촬영 — 공간어스`;
const description = `${d.summary} ${d.year}년 ${d.location ? d.location + ' ' : ''}${cat.label} 공간 사진 ${images.length}장.`;
const ogImage = `/work/${work.id}/og.jpg`;
const jsonLd = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Work', item: `${siteConfig.url}/work/` },
    { '@type': 'ListItem', position: 2, name: cat.label, item: new URL(categoryUrl(d.category), siteConfig.url).href },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
}, {
  '@type': 'ImageGallery',
  name: `${d.title} ${cat.label} 촬영`,
  description: d.summary,
  url: new URL(workUrl(work), siteConfig.url).href,
  datePublished: `${d.year}-01-01`,
  author: { '@id': `${siteConfig.url}/#business` },
  numberOfItems: images.length,
}];
---
<Base title={title} description={description} image={ogImage} jsonLd={jsonLd}>
  <article>
    <div class="cover" transition:name={`cover-${work.id}`}>
      <Image src={cover} alt={`${d.title} 공간 사진 1`} widths={[960, 1440, 1920, 2560]} sizes="100vw" width={2560} height={Math.round(2560 * cover.height / cover.width)} loading="eager" fetchpriority="high" />
    </div>
    <div class="container layout">
      <aside class="side">
        <div class="sticky" data-reveal>
          <p class="eyebrow"><a href={categoryUrl(d.category)}>{cat.label}</a></p>
          <h1>{d.title}</h1>
          <p class="summary muted"><Sentences text={d.summary} /></p>
          <dl class="facts">
            <div><dt>Year</dt><dd>{d.year}</dd></div>
            {d.location && <div><dt>Location</dt><dd>{d.location}</dd></div>}
            <div><dt>Photos</dt><dd>{images.length}</dd></div>
          </dl>
        </div>
      </aside>
      <div class="gallery">
        {rows.map((row) => (
          <div class:list={['row', row.kind]}>
            {row.items.map((img) => {
              const n = images.indexOf(img) + 1;
              const w = row.kind === 'wide' ? 1920 : 1200;
              return <div class="img-zoom" data-reveal="wipe" data-parallax="soft"><Image src={img.image} alt={`${d.title} 공간 사진 ${n}`} widths={row.kind === 'wide' ? [960, 1440, 1920] : [640, 960, 1440]} sizes={row.kind === 'wide' ? '(max-width: 1024px) 100vw, 66vw' : '(max-width: 640px) 100vw, 40vw'} width={w} height={Math.round(w * img.image.height / img.image.width)} loading="lazy" /></div>;
            })}
          </div>
        ))}
      </div>
    </div>
    <nav class="container adjacent" aria-label="다른 프로젝트" data-reveal>
      {prev ? <a href={workUrl(prev)} class="adj"><span class="muted">Prev</span><strong>{prev.data.title}</strong></a> : <span />}
      <a href="/work/" class="link">All Work</a>
      {next ? <a href={workUrl(next)} class="adj right"><span class="muted">Next</span><strong>{next.data.title}</strong></a> : <span />}
    </nav>
  </article>
  <Cta title={`${cat.label} 공간 촬영이 필요하다면`} />
</Base>
<style>
  .cover { aspect-ratio: 16 / 9; max-height: 92vh; }
  .cover img { width: 100%; height: 100%; }
  .layout { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding-top: clamp(32px, 4vw, 56px); padding-bottom: clamp(48px, 6vw, 96px); align-items: start; }
  .sticky { position: sticky; top: 96px; display: grid; gap: 18px; }
  .eyebrow a { border-bottom: 1px solid currentColor; }
  h1 { font-size: clamp(30px, 3.4vw, 52px); }
  .summary { font-size: 16px; max-width: 30em; }
  .facts { display: grid; gap: 10px; margin: 8px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 14px; }
  .facts div { display: flex; justify-content: space-between; gap: 16px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; font-weight: 500; }
  .gallery { display: grid; gap: clamp(32px, 4vw, 64px); }
  .row.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .row.pair > :last-child:not(:only-child) { margin-top: clamp(24px, 4vw, 64px); }
  .row.right { display: flex; justify-content: flex-end; }
  .row.left { display: flex; justify-content: flex-start; }
  .row.right > *, .row.left > * { width: 62%; }
  .row .img-zoom { overflow: hidden; }
  .row .img-zoom img { width: 100%; height: auto; will-change: transform; }
  .cover { overflow: hidden; background: var(--soft); }
  .row.pair > :only-child { grid-column: 1 / -1; width: 70%; margin: 0 auto; }
  .adjacent { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding-top: 40px; padding-bottom: 56px; border-top: 1px solid var(--line); }
  .adj { display: grid; gap: 4px; font-size: 13px; }
  .adj strong { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
  .right { text-align: right; }
  @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; gap: 32px; } .sticky { position: static; } }
  @media (max-width: 640px) { .row.pair { grid-template-columns: 1fr; gap: 20px; } .row.pair > :last-child:not(:only-child) { margin-top: 0; } .row.pair > :only-child, .row.right > *, .row.left > * { width: 100%; } .gallery { gap: 24px; } .cover { aspect-ratio: 4 / 5; } }
</style>
