---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Cta from '../components/Cta.astro';
import Words from '../components/Words.astro';
import Sentences from '../components/Sentences.astro';
import { siteConfig } from '../site.config';
import { getAllWork, getFeaturedWork, getCover, workUrl } from '../lib/work';
const all = await getAllWork();
const featured = await getFeaturedWork(7);
const heroIds = ['stay-namyangju-damyeonjae', 'showroom-duomo-lighting', 'cafe-y3s', 'showroom-knoll', 'apt-sindang-hyundai'];
const slides = heroIds.map((id) => all.find((w) => w.id === id)).filter(Boolean).map((w) => ({ work: w!, image: getCover(w!.id, w!.data.cover) }));
const hero = slides[0].work;
const heroImage = slides[0].image;
const lcp = await Promise.all([960, 1440, 1920].map((w) => getImage({ src: heroImage, width: w, format: 'webp', quality: 72 })));
const lcpSrcset = lcp.map((r, i) => `${r.src} ${[960, 1440, 1920][i]}w`).join(', ');
const principles = [
  { k: 'vertical', t: '수직을 세웁니다', d: '공간 사진에서 기울어진 수직선은 가장 먼저 눈에 띄는 결함입니다. 촬영 단계에서 카메라 수평을 잡고, 후보정에서 원근을 정리해 벽과 기둥, 창틀의 수직을 유지합니다.', id: 'showroom-knoll' },
  { k: 'light', t: '빛을 섞지 않습니다', d: '대부분의 인테리어 공간에는 자연광과 전구색 조명, 주광색 LED가 동시에 존재합니다. 색온도가 뒤섞이면 애써 고른 마감재의 색이 무너집니다. 조명 조건을 정리하고, 필요하면 광원별로 나누어 촬영한 뒤 후반 작업에서 한 컷으로 블렌딩합니다.', id: 'beauty-onhyu-spa' },
  { k: 'window', t: '창을 살립니다', d: '실내에 노출을 맞추면 창이 하얗게 날아가고, 창에 맞추면 실내가 어두워집니다. 실내와 창밖의 노출을 각각 확보해 후반에서 정교하게 블렌딩하고, 공간이 실제로 보이는 그대로 밝게, 바깥 풍경까지 담습니다.', id: 'cafe-y3s' },
].map((p) => ({ ...p, image: getCover(p.id, all.find((w) => w.id === p.id)!.data.cover) }));
const clients = ['Knoll', 'Duomo Lighting', 'Knotty', 'OODOOD', 'Y3S', '프뤼떼마지', '마조리카', '모모란위그', '온휴스파', '그리디센트', '그린보이즈', '오션키즈', '담연재', '안월재', 'Mukta'];
const strengths = [
  { t: '사진과 영상, 한 번의 촬영으로', d: '한 번의 방문으로 사진과 영상을 함께 촬영합니다. 일정은 하루로, 결과물의 톤은 하나로 맞춥니다.' },
  { t: '촬영부터 편집까지 한 곳에서', d: '촬영, 색보정, 편집을 한 곳에서 마무리합니다. 공정이 나뉘지 않아 완성도가 흔들리지 않습니다.' },
  { t: '촬영 후 5일 안에 납품', d: '한 번에 한 공간에만 집중합니다. 보정과 편집을 마친 완성본을 촬영 후 5일 안에 전달합니다.' },
  { t: '컷 수 제한 없이', d: '공간마다 분위기와 인테리어가 다릅니다. 장수를 정해두지 않고, 그 공간이 가진 장면을 최대한 많이 담습니다.' },
];
const services = [
  { n: '01', t: '공간 사진', d: '수직과 원근을 정리하고 조명 색을 맞춘 인테리어 사진. 컷 수 제한 없이, 보정까지 마쳐 전달합니다.' },
  { n: '02', t: '공간 영상', d: '동선과 빛을 따라가는 짧은 영상. 릴스 / 쇼츠용 세로 또는 웹 / 유튜브용 가로 포맷 중 선택.' },
  { n: '03', t: '사진 + 영상 패키지', d: '한 번의 방문으로 두 결과물을 같은 빛, 같은 톤으로. 가장 많이 선택하는 방식.' },
];
---
<Base title="공간어스 | 인테리어 / 공간 사진 영상 촬영 스튜디오" description={siteConfig.description}>
  <link slot="head" rel="preload" as="image" imagesrcset={lcpSrcset} imagesizes="100vw" fetchpriority="high" />
  <section class="hero grain" data-hero-dark>
    <div class="hero-media" data-parallax style={`--n:${slides.length}`}>
      <div class="slide base"><Image src={heroImage} alt={`${hero.data.title} 공간 사진`} widths={[960, 1440, 1920]} sizes="100vw" width={1920} height={1280} quality={72} loading="eager" fetchpriority="high" /></div>
      {slides.map((s, i) => <div class="slide" style={`--i:${i}`}><Image src={s.image} alt={`${s.work.data.title} 공간 사진`} widths={[960, 1440, 1920]} sizes="100vw" width={1920} height={1280} quality={72} loading="lazy" /></div>)}
    </div>
    <div class="container hero-content">
      <p class="eyebrow hero-eyebrow">Interior &amp; Space / Photography / Film</p>
      <h1 class="display">
        <span class="line"><span>공간을 이해하고,</span></span>
        <span class="line"><span>기록합니다.</span></span>
      </h1>
      <div class="hero-row">
        <p class="lead">모든 공간에는 이유와 철학이 담겨 있습니다.<br />공간어스는 브랜드를 위해, 그 이유가 읽히는 사진과 영상을 남깁니다.</p>
        <a href="/work/" class="btn">포트폴리오 보기</a>
      </div>
      <div class="hero-captions" style={`--n:${slides.length}`}>
        {slides.map((s, i) => <span class="hero-caption" style={`--i:${i}`}><span class="dot"></span>{s.work.data.title} <span class="dim">— {s.work.data.year}</span></span>)}
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span></span></div>
  </section>

  <div class="marquee big" aria-hidden="true">
    <div class="track">{[...clients, ...clients].map((c) => <span>{c}</span>)}</div>
  </div>

  <section class="section">
    <div class="container">
      <div class="head">
        <h2 data-reveal="line"><Words text="Selected Work" /></h2>
        <a href="/work/" class="link" data-reveal>전체 보기 →</a>
      </div>
      <WorkGrid works={featured} eagerCount={0} />
    </div>
  </section>

  <section class="section dark grain">
    <div class="container">
      <div class="intro">
        <p class="eyebrow" data-reveal>Why gonganus</p>
        <h2 data-reveal="line"><Words text="결과물이 다른 이유" /></h2>
        <p class="lead muted" data-reveal>보기 좋은 사진보다 정확한 사진을 목표로 합니다.<br />설계자가 고른 마감재의 색, 조명의 온도, 창으로 들어오는 빛이 실제와 같아야 합니다.</p>
      </div>
      <ul class="svc stagger">
        {services.map((s) => <li data-reveal><a href="/services/"><span class="num">{s.n}</span><h3>{s.t}</h3><p class="muted"><Sentences text={s.d} /></p><span class="arrow">→</span></a></li>)}
      </ul>
      <ul class="strengths stagger">
        {strengths.map((s, i) => <li data-reveal><span class="num">0{i + 1}</span><h3>{s.t}</h3><p class="muted"><Sentences text={s.d} /></p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container principles">
      <div class="p-media">
        <div class="p-sticky">
          {principles.map((p, i) => <div data-principle-img={p.k} class:list={['p-img', { active: i === 0 }]}><Image src={p.image} alt={`${p.t} — ${p.t}`} widths={[720, 1080, 1440]} sizes="(max-width: 1024px) 100vw, 45vw" width={1440} height={1800} loading="lazy" /></div>)}
        </div>
      </div>
      <div class="p-text">
        <p class="eyebrow" data-reveal>Principles</p>
        <h2 data-reveal="line"><span class="clause"><Words text="수직을 세우고," /></span><br /><span class="clause"><Words text="빛을 섞지 않고," /></span><br /><span class="clause"><Words text="창을 살립니다." /></span></h2>
        <ol class="p-list">
          {principles.map((p, i) => <li data-principle={p.k} class:list={{ active: i === 0 }} tabindex="0"><div class="p-inline"><Image src={p.image} alt={`${p.t} 예시 사진`} widths={[640, 960]} sizes="100vw" width={960} height={720} loading="lazy" /></div><span class="num">0{i + 1}</span><h3>{p.t}</h3><p class="muted"><Sentences text={p.d} /></p></li>)}
        </ol>
        <a href="/about/" class="link" data-reveal>촬영 기준 자세히 →</a>
      </div>
    </div>
  </section>

  <Cta />
</Base>
<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; margin-top: -84px; }
  .hero-media { position: absolute; inset: 0; background: #111; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.16); will-change: transform; }
  .slide { position: absolute; inset: 0; opacity: 0; animation: slide calc(var(--n) * 7s) linear infinite; animation-delay: calc(var(--i) * 7s); }
  .slide.base { opacity: 1; animation: kb 1.6s ease-out both; }
  .slide img { animation: kb-zoom calc(var(--n) * 7s) linear infinite; animation-delay: calc(var(--i) * 7s); }
  .slide.base img { animation: none; }
  @keyframes slide { 0% { opacity: 0; } 7% { opacity: 1; } 23% { opacity: 1; } 30% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes kb-zoom { 0% { scale: 1; } 30% { scale: 1.04; } 100% { scale: 1.04; } }
  @keyframes kb { from { opacity: 0; } }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.4) 0%, rgba(0,0,0,.05) 40%, rgba(0,0,0,.62) 100%), radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(0,0,0,.45) 100%); }
  .hero-content { position: relative; width: 100%; padding-top: 140px; padding-bottom: clamp(40px, 7vw, 96px); max-width: var(--max); }
  .hero-eyebrow { color: rgba(255,255,255,.75); margin-bottom: 22px; opacity: 0; animation: fadeup 1s var(--ease) .5s forwards; }
  .display { font-size: clamp(34px, 5.6vw, 88px); line-height: 1.12; letter-spacing: -0.035em; font-weight: 500; }
  .line { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
  .line > span { display: block; transform: translateY(110%); animation: rise 1.2s var(--ease) .25s forwards; }
  .line:nth-child(2) > span { animation-delay: .38s; }
  @keyframes rise { to { transform: none; } }
  .hero-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-top: clamp(24px, 3vw, 40px); opacity: 0; animation: fadeup 1s var(--ease) .7s forwards; }
  .hero-row .lead { color: rgba(255,255,255,.88); }
  .hero .btn { border-color: #fff; color: #fff; }
  .hero .btn:hover { background: #fff; color: #111; }
  @keyframes fadeup { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .hero-captions { position: relative; height: 20px; margin-top: clamp(28px, 4vw, 48px); }
  .hero-caption { position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 500; opacity: 0; animation: cap calc(var(--n) * 7s) linear infinite; animation-delay: calc(var(--i) * 7s); pointer-events: none; }
  .hero-caption[style*='--i:0'] { animation-name: cap-first; }
  @keyframes cap { 0% { opacity: 0; } 3% { opacity: 0; } 6% { opacity: 1; } 22% { opacity: 1; } 24% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes cap-first { 0% { opacity: 1; } 22% { opacity: 1; } 24% { opacity: 0; } 98% { opacity: 0; } 100% { opacity: 1; } }
  .hero-caption .dim { color: rgba(255,255,255,.6); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  .scroll-hint { position: absolute; right: var(--gutter); bottom: clamp(36px, 6vw, 80px); width: 1px; height: 56px; background: rgba(255,255,255,.25); overflow: hidden; }
  .scroll-hint span { position: absolute; left: 0; top: 0; width: 100%; height: 40%; background: #fff; animation: drop 1.8s var(--ease) infinite; }
  @keyframes drop { from { transform: translateY(-100%); } to { transform: translateY(260%); } }

  .marquee.big { padding: 22px 0; }
  .marquee.big .track span { font-size: clamp(18px, 2.2vw, 30px); color: var(--fg); letter-spacing: -0.02em; text-transform: uppercase; }

  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 40px; gap: 24px; }
  .intro { display: grid; gap: 20px; max-width: 760px; }
  .svc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); margin: clamp(40px, 6vw, 80px) 0; }
  .svc li { border-bottom: 1px solid var(--line); }
  .svc li + li { border-left: 1px solid var(--line); }
  .svc a { display: grid; gap: 12px; padding: 32px 28px 36px; height: 100%; position: relative; transition: background .5s var(--ease); }
  .svc a:hover { background: #151514; }
  .svc h3 { font-size: 22px; letter-spacing: -0.02em; }
  .svc p { font-size: 15px; max-width: 26em; }
  .svc .arrow { position: absolute; right: 28px; top: 30px; font-size: 18px; transition: transform .5s var(--ease); }
  .svc a:hover .arrow { transform: translateX(6px); }
  .svc li:first-child a { padding-left: 0; }
  .strengths { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 32px; }
  .strengths li { border-top: 1px solid var(--line); padding-top: 22px; }
  .num { display: block; font-size: 12px; color: var(--muted); margin-bottom: 14px; letter-spacing: .08em; }
  .strengths h3 { margin-bottom: 12px; }
  .strengths p { font-size: 15px; }
  .principles { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .principles h2 { font-size: clamp(28px, 4vw, 60px); }
  .principles .clause { white-space: nowrap; }
  .p-sticky { position: sticky; top: 100px; aspect-ratio: 4 / 5; overflow: hidden; background: var(--soft); }
  .p-img { position: absolute; inset: 0; opacity: 0; transition: opacity 1s var(--ease); }
  .p-img img { width: 100%; height: 100%; object-fit: cover; }
  .p-img.active { opacity: 1; }
  .p-inline { display: none; }
  .p-text { display: grid; gap: 28px; padding-top: 8px; }
  .p-list { display: grid; gap: 0; margin-top: 12px; }
  .p-list li { border-top: 1px solid var(--line); padding: 28px 0; opacity: .38; transition: opacity .6s var(--ease); cursor: default; outline: none; }
  .p-list li.active { opacity: 1; }
  .p-list h3 { font-size: clamp(20px, 1.8vw, 26px); margin-bottom: 12px; }
  .p-list p { max-width: 34em; }
  @media (max-width: 1024px) { .principles { grid-template-columns: 1fr; } .p-media { display: none; } .p-list li { opacity: 1; } .p-inline { display: block; aspect-ratio: 4 / 3; overflow: hidden; margin-bottom: 20px; background: var(--soft); } .p-inline img { width: 100%; height: 100%; object-fit: cover; } }
  @media (max-width: 1024px) { .strengths { grid-template-columns: repeat(2, 1fr); } .svc { grid-template-columns: 1fr; } .svc li + li { border-left: 0; } .svc a, .svc li:first-child a { padding: 24px 0 28px; } .svc .arrow { right: 0; top: 24px; } }
  @media (max-width: 768px) {
    .hero { min-height: 92svh; }
    .hero-row { flex-direction: column; align-items: flex-start; gap: 20px; }
    .hero-row .lead { font-size: 16px; }
    .display { font-size: clamp(32px, 8.8vw, 42px); line-height: 1.14; }
    .scroll-hint { display: none; }
    .head { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  @media (max-width: 640px) { .strengths { grid-template-columns: 1fr; gap: 28px; } }
  @media (prefers-reduced-motion: reduce) { .line > span, .hero-row, .hero-eyebrow { animation: none; transform: none; opacity: 1; } .slide:not(.base), .hero-caption:not([style*='--i:0']) { display: none; } .hero-caption, .slide.base, .slide img { animation: none; opacity: 1; } }
</style>
