---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Sentences from '../../components/Sentences.astro';
import { siteConfig } from '../../site.config';
import { getAllWork, getWorkByCategory, CATEGORIES, categoryUrl } from '../../lib/work';
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const d = guide.data;
const { Content } = await render(guide);
const related = d.category ? (await getWorkByCategory(d.category)).slice(0, 3) : (await getAllWork()).filter((w) => w.data.featured).slice(0, 3);
const others = (await getCollection('guides')).filter((g) => g.id !== guide.id).sort((a, b) => a.data.order - b.data.order);
const url = `${siteConfig.url}/guide/${guide.id}/`;
const jsonLd = [
  { '@type': 'Article', headline: d.question, description: d.description, url, author: { '@id': `${siteConfig.url}/#business` }, publisher: { '@id': `${siteConfig.url}/#business` }, inLanguage: 'ko', keywords: d.keywords.join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Guide', item: `${siteConfig.url}/guide/` }, { '@type': 'ListItem', position: 2, name: d.title }] },
  ...(d.faq.length ? [{ '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={`${d.question} | 공간어스`} description={d.description} jsonLd={jsonLd}>
  <article class="section">
    <div class="container narrow">
      <p class="eyebrow" data-reveal><a href="/guide/">Guide</a> / {d.title}</p>
      <h1 data-reveal>{d.question}</h1>
      <p class="answer" data-reveal><Sentences text={d.answer} /></p>
      <div class="prose" data-reveal><Content /></div>
      {d.faq.length > 0 && (
        <section class="faq" data-reveal>
          <h2>자주 묻는 질문</h2>
          <dl>{d.faq.map((f) => <div><dt>{f.q}</dt><dd class="muted"><Sentences text={f.a} /></dd></div>)}</dl>
        </section>
      )}
    </div>
    {related.length > 0 && (
      <div class="container related">
        <div class="head"><h2>{d.category ? `${CATEGORIES[d.category].label} 촬영 사례` : '촬영 사례'}</h2><a class="link" href={d.category ? categoryUrl(d.category) : '/work/'}>더 보기 →</a></div>
        <WorkGrid works={related} eagerCount={0} />
      </div>
    )}
    <div class="container more" data-reveal>
      <p class="eyebrow">다른 가이드</p>
      <ul>{others.map((g) => <li><a href={`/guide/${g.id}/`}>{g.data.question} →</a></li>)}</ul>
    </div>
  </article>
  <Cta title="촬영을 계획 중이라면" />
</Base>
<style>
  .narrow { max-width: 820px; margin-left: 0; }
  .eyebrow a { border-bottom: 1px solid currentColor; }
  h1 { font-size: clamp(28px, 3.6vw, 52px); }
  .answer { margin-top: 24px; font-size: clamp(17px, 1.4vw, 21px); line-height: 1.75; padding: 24px 0; border-top: 1px solid var(--fg); border-bottom: 1px solid var(--line); }
  .prose { margin-top: 40px; font-size: 16px; line-height: 1.85; }
  .prose :global(h2) { font-size: clamp(22px, 2vw, 28px); margin: 48px 0 16px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px 1.2em; padding: 0; list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 24px; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px 14px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { font-weight: 500; color: var(--muted); font-size: 13px; letter-spacing: .04em; }
  .faq { margin-top: 56px; }
  .faq h2 { font-size: clamp(22px, 2vw, 28px); margin-bottom: 8px; }
  .faq dl > div { border-top: 1px solid var(--line); padding: 20px 0; }
  .faq dt { font-weight: 500; font-size: 17px; margin-bottom: 8px; }
  .faq dd { margin: 0; }
  .related { margin-top: clamp(56px, 8vw, 96px); }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .more { margin-top: clamp(48px, 6vw, 80px); }
  .more ul { display: grid; gap: 10px; font-size: 16px; font-weight: 500; }
</style>
