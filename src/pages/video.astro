---
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Cta from '../components/Cta.astro';
import videos from '../content/videos.json';
const landscape = videos.filter((v) => v.ratio === '16:9');
const portrait = videos.filter((v) => v.ratio === '9:16');
---
<Base title="영상 | 공간어스 인테리어·공간 영상 촬영" description={`브랜드의 정체성을 공간의 움직임으로 담는 공간어스의 영상 ${videos.length}편. 릴스용 세로 또는 웹용 가로 포맷을 선택해 사진 촬영과 같은 날 제작합니다.`}>
  <section class="section dark grain">
    <div class="container">
      <h1 data-reveal>Video</h1>
      <p class="lead muted" style="margin-top:16px">브랜드의 정체성을 공간의 움직임으로 담습니다.<br />사진 촬영과 같은 날, 같은 빛 아래에서 동선과 빛의 흐름을 따라 촬영합니다.<br />릴스·쇼츠용 세로 또는 웹·유튜브용 가로 포맷 중 용도에 맞는 하나를 선택해, 색보정과 편집까지 마쳐 전달합니다.</p>
      {landscape.length > 0 && <div class="vgrid land stagger">{landscape.map((v) => <VideoEmbed {...v} ratio={v.ratio as '16:9' | '9:16'} />)}</div>}
      {portrait.length > 0 && <div class="vgrid port stagger">{portrait.map((v) => <VideoEmbed {...v} ratio={v.ratio as '16:9' | '9:16'} />)}</div>}
    </div>
  </section>
  <Cta title="공간 영상이 필요하다면" />
</Base>
<style>
  .vgrid { display: grid; gap: 40px 24px; margin-top: 48px; }
  .land { grid-template-columns: repeat(2, 1fr); }
  .port { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1024px) { .port { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) { .land { grid-template-columns: 1fr; } .port { grid-template-columns: repeat(2, 1fr); } }
</style>
