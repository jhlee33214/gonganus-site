---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다 — 공간어스" description="요청하신 페이지가 없습니다. 공간어스 홈 또는 포트폴리오로 이동해 주세요.">
  <section class="section">
    <div class="container" style="min-height:50vh">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p class="lead muted" style="margin:16px 0 32px">주소가 바뀌었거나 없는 페이지입니다.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn primary" href="/">홈으로</a><a class="btn" href="/work/">포트폴리오</a></div>
    </div>
  </section>
</Base>
