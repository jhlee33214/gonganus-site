---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Sentences from '../components/Sentences.astro';
const services = [
  { t: '공간 사진', d: '설계된 구조와 마감의 디테일을 정확하게 담습니다. 수직을 세우고, 조명의 색을 정리하고, 창밖 풍경까지 살립니다.', out: ['컷 수 제한 없음. 공간의 장면을 최대한 많이 기록', '전 컷 보정을 마친 완성본으로 전달', '촬영 후 5일 이내 납품'] },
  { t: '공간 영상', d: '공간의 동선과 빛의 변화를 따라가는 짧은 영상입니다. 릴스·쇼츠용 세로와 웹·유튜브용 가로 중 용도에 맞는 포맷을 선택해 편집합니다.', out: ['색보정·편집을 마친 완성본으로 전달', '세로 9:16 또는 가로 16:9 중 선택', '로고 삽입본과 미삽입본 함께 전달'] },
  { t: '사진 + 영상 패키지', d: '한 번의 방문으로 사진과 영상을 함께 촬영합니다. 같은 빛과 톤으로 결과물이 통일되고, 따로 진행할 때보다 일정과 비용을 크게 줄일 수 있습니다.', out: ['사진 전 컷 + 영상 1편', '오픈·리뉴얼·시공 완료 시점에 가장 많이 선택', '가장 합리적인 견적'] },
];
const steps = [
  { t: '문의', d: '공간 종류·위치·평수·희망 일정을 카카오톡이나 이메일로 보내주세요. 빠른 시간 안에 견적을 드립니다.' },
  { t: '일정 확정', d: '자연광이 가장 좋은 시간대로 촬영일을 정합니다. 정리, 소품, 조명 등 준비 사항은 미리 안내해 드립니다.' },
  { t: '촬영', d: '공간 규모에 따라 2~4시간이 걸립니다. 하루에 한 공간만 촬영합니다.' },
  { t: '납품', d: '촬영 후 5일 안에 보정과 편집을 마친 완성본을 전달합니다. 1회 수정이 포함됩니다.' },
];
const faqs = [
  { q: '인테리어 촬영 비용은 얼마인가요?', a: '공간 크기와 결과물(사진만 / 영상만 / 사진+영상)에 따라 달라집니다. 공간 종류·평수·희망 일정을 보내주시면 빠른 시간 안에 견적을 드립니다. 사진과 영상을 한 번에 진행하는 패키지가 가장 합리적입니다.' },
  { q: '촬영은 얼마나 걸리나요?', a: '공간 규모에 따라 보통 2~4시간입니다. 카페·쇼룸처럼 한 층 규모는 2~3시간, 여러 객실이 있는 숙박 공간은 3~4시간을 잡습니다.' },
  { q: '결과물은 언제 받나요?', a: '촬영 후 5일 안에 보정·편집을 마친 완성본을 전달합니다. 전달 후 1회 수정 요청을 받습니다.' },
  { q: '어디까지 출장이 가능한가요?', a: '서울·수도권은 기본이고 전국 출장이 가능합니다. 수도권 밖은 거리에 따라 출장비가 견적에 포함됩니다.' },
  { q: '촬영 전에 무엇을 준비해야 하나요?', a: '동선에 있는 물건 정리, 조명 전체 점등, 창 청소 정도면 충분합니다. 소품 배치와 조명 조건은 촬영 당일 현장에서 함께 정리합니다.' },
  { q: '사진은 어떤 용도로 쓸 수 있나요?', a: '보정을 마친 완성본으로 전달하며, 홈페이지, 인스타그램, 네이버 플레이스, 인쇄물, 제안서 등에 그대로 사용하실 수 있습니다.' },
];
const jsonLd = [{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
const targets = [
  { t: '인테리어·시공 회사', d: '시공 완료 후 포트폴리오와 제안서에 쓸 사진·영상' },
  { t: '가구·조명 브랜드 쇼룸', d: '제품과 공간이 함께 보이는 브랜드 콘텐츠' },
  { t: '카페·리테일·사무실', d: '오픈 홍보, 네이버 플레이스, 인스타그램용' },
  { t: '숙박(에어비앤비·펜션·독채)', d: '예약 전환을 높이는 객실·외관 사진' },
  { t: '아파트·주택', d: '시공 사례 기록과 임대·매매용' },
];
---
<Base title="서비스 | 공간 사진·영상 촬영, 패키지 — 공간어스" description="인테리어 촬영 서비스 안내. 공간 사진(컷 수 제한 없음), 공간 영상(릴스·웹용 편집본), 사진+영상 패키지. 촬영 후 5일 이내 납품, 서울·수도권 및 전국 출장. 견적은 문의." jsonLd={jsonLd}>
  <section class="section">
    <div class="container">
      <h1 data-reveal>Services</h1>
      <p class="lead muted" style="margin-top:16px">공간의 규모와 필요한 결과물에 따라 세 가지 방식 중 선택하실 수 있습니다.<br />비용은 공간 크기와 결과물 수량에 따라 견적으로 안내해 드립니다.</p>
      <ul class="services stagger">
        {services.map((s, i) => (
          <li data-reveal>
            <span class="num">0{i + 1}</span>
            <h2>{s.t}</h2>
            <p class="muted"><Sentences text={s.d} /></p>
            <ul class="out">{s.out.map((o) => <li>{o}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h2 data-reveal>진행 순서</h2>
      <ol class="steps stagger">
        {steps.map((s, i) => <li data-reveal><span class="num">{i + 1}</span><h3>{s.t}</h3><p class="muted"><Sentences text={s.d} /></p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">For</p>
      <h2 data-reveal>이런 분들이 찾습니다</h2>
      <ul class="targets stagger">
        {targets.map((t) => <li data-reveal><h3>{t.t}</h3><p class="muted">{t.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">FAQ</p>
      <h2 data-reveal>자주 묻는 질문</h2>
      <dl class="faq">
        {faqs.map((f) => <div data-reveal><dt>{f.q}</dt><dd class="muted"><Sentences text={f.a} /></dd></div>)}
      </dl>
    </div>
  </section>

  <Cta title="견적이 필요하다면" body={"공간 종류·위치·평수와 희망 일정만 보내주세요.\n빠른 시간 안에 답변드립니다."} />
</Base>
<style>
  .num { display: block; font-size: 13px; color: var(--muted); margin-bottom: 12px; }
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 48px; }
  .services > li { border-top: 1px solid var(--fg); padding-top: 24px; }
  .services h2 { margin-bottom: 12px; }
  .services p { font-size: 15px; }
  .out { margin-top: 20px; display: grid; gap: 8px; font-size: 14px; }
  .out li { padding-left: 14px; position: relative; }
  .out li::before { content: ''; position: absolute; left: 0; top: .75em; width: 5px; height: 1px; background: var(--fg); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 40px; padding: 0; list-style: none; }
  .steps li { border-top: 1px solid var(--line); padding-top: 20px; }
  .steps h3 { margin-bottom: 10px; }
  .steps p { font-size: 15px; }
  .targets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; margin-top: 40px; }
  .targets li { border-top: 1px solid var(--line); padding-top: 16px; }
  .targets h3 { margin-bottom: 6px; }
  .targets p { font-size: 15px; }
  .faq { display: grid; gap: 0; margin-top: 32px; max-width: 880px; }
  .faq > div { border-top: 1px solid var(--line); padding: 20px 0; }
  .faq dt { font-weight: 500; font-size: 17px; margin-bottom: 8px; }
  .faq dd { margin: 0; font-size: 15px; }
  @media (max-width: 1024px) { .services, .targets { grid-template-columns: repeat(2, 1fr); } .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .services, .steps, .targets { grid-template-columns: 1fr; gap: 28px; } }
</style>
