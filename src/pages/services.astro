---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
const services = [
  { t: '공간 사진', d: '인테리어의 구조와 디테일을 정확하게 남기는 사진 촬영. 벽과 창틀의 수직을 세우고, 조명 색을 정리하고, 창밖까지 살려 촬영합니다.', out: ['기본 보정 + 세부 보정을 거친 사진 30장 이상', '홈페이지·인스타그램·인쇄용 크기 각각 전달', '촬영 후 5일 이내 납품'] },
  { t: '공간 영상', d: '공간의 동선과 분위기를 담는 영상 촬영과 편집. 릴스·쇼츠용 세로 영상과 홈페이지·유튜브용 가로 영상을 만듭니다.', out: ['편집·색보정을 마친 2분 이내 영상', '세로(9:16) 또는 가로(16:9) 선택, 둘 다 가능', '로고 삽입본과 미삽입본 함께 전달'] },
  { t: '사진 + 영상 패키지', d: '한 번의 방문으로 사진과 영상을 동시에 촬영합니다. 같은 조명 조건에서 같은 톤으로 만들어 결과물이 통일되고, 따로 진행할 때보다 일정과 비용이 줄어듭니다.', out: ['사진 30장 이상 + 영상 1편', '오픈·리뉴얼·시공 완료 시점에 가장 많이 선택', '가장 합리적인 견적'] },
];
const steps = [
  { t: '문의', d: '공간 종류, 위치, 평수, 원하는 결과물과 희망 일정을 카카오톡이나 이메일로 알려주세요. 하루 안에 견적을 보내드립니다.' },
  { t: '일정 확정', d: '촬영일과 시간대를 정합니다. 자연광이 가장 좋은 시간을 함께 잡고, 정리·소품·조명 준비 사항을 미리 안내합니다.' },
  { t: '촬영', d: '공간 규모에 따라 2~4시간. 여러 의뢰를 한 날에 몰아 받지 않고 한 공간에 집중합니다.' },
  { t: '납품', d: '촬영 후 5일 안에 보정·편집을 마친 완성본을 전달합니다. 전달 후 1회 수정 요청을 받습니다.' },
];
const targets = [
  { t: '인테리어·시공 회사', d: '시공 완료 후 포트폴리오와 제안서에 쓸 사진·영상' },
  { t: '가구·조명 브랜드 쇼룸', d: '제품과 공간이 함께 보이는 브랜드 콘텐츠' },
  { t: '카페·리테일·사무실', d: '오픈 홍보, 네이버 플레이스, 인스타그램용' },
  { t: '숙박(에어비앤비·펜션·독채)', d: '예약 전환을 높이는 객실·외관 사진' },
  { t: '아파트·주택', d: '시공 사례 기록과 임대·매매용' },
];
---
<Base title="서비스 — 공간 사진·영상 촬영, 사진+영상 패키지 | 공간어스" description="공간어스의 인테리어 촬영 서비스. 공간 사진(보정 사진 30장 이상), 공간 영상(2분 이내 편집본), 사진+영상 패키지. 촬영 후 5일 이내 납품, 서울·수도권 및 전국 출장. 견적은 문의해 주세요.">
  <section class="section">
    <div class="container">
      <h1>Services</h1>
      <p class="lead muted" style="margin-top:12px">공간의 규모와 필요한 결과물에 따라 세 가지 방식 중 고르실 수 있습니다. 가격은 공간 크기와 결과물 수량에 따라 달라지므로 문의 주시면 견적으로 안내드립니다.</p>
      <ul class="services">
        {services.map((s, i) => (
          <li>
            <span class="num">0{i + 1}</span>
            <h2>{s.t}</h2>
            <p class="muted">{s.d}</p>
            <ul class="out">{s.out.map((o) => <li>{o}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h2>진행 순서</h2>
      <ol class="steps">
        {steps.map((s, i) => <li><span class="num">{i + 1}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">For</p>
      <h2>이런 분들이 찾습니다</h2>
      <ul class="targets">
        {targets.map((t) => <li><h3>{t.t}</h3><p class="muted">{t.d}</p></li>)}
      </ul>
    </div>
  </section>

  <Cta title="견적이 필요하신가요?" body="공간 종류·위치·평수와 희망 일정을 보내주시면 하루 안에 견적을 드립니다." />
</Base>
<style>
  .num { display: block; font-size: 13px; color: var(--muted); margin-bottom: 12px; }
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 48px; }
  .services > li { border-top: 1px solid var(--fg); padding-top: 24px; }
  .services h2 { margin-bottom: 12px; }
  .services p { font-size: 15px; }
  .out { margin-top: 20px; display: grid; gap: 8px; font-size: 14px; }
  .out li { padding-left: 14px; position: relative; }
  .out li::before { content: ''; position: absolute; left: 0; top: .75em; width: 5px; height: 1px; background: var(--fg); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 40px; padding: 0; list-style: none; }
  .steps li { border-top: 1px solid var(--line); padding-top: 20px; }
  .steps h3 { margin-bottom: 10px; }
  .steps p { font-size: 15px; }
  .targets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; margin-top: 40px; }
  .targets li { border-top: 1px solid var(--line); padding-top: 16px; }
  .targets h3 { margin-bottom: 6px; }
  .targets p { font-size: 15px; }
  @media (max-width: 1024px) { .services, .targets { grid-template-columns: repeat(2, 1fr); } .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .services, .steps, .targets { grid-template-columns: 1fr; gap: 28px; } }
</style>
