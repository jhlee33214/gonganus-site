---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Sentences from '../../components/Sentences.astro';
import { siteConfig } from '../../site.config';
import { AREAS } from '../../lib/areas';
import { getAllWork, CATEGORIES } from '../../lib/work';
export function getStaticPaths() { return AREAS.map((a) => ({ params: { area: a.slug }, props: { area: a } })); }
const { area } = Astro.props;
const all = await getAllWork();
const works = area.projects.map((id) => all.find((w) => w.id === id)).filter(Boolean) as typeof all;
const url = `${siteConfig.url}/area/${area.slug}/`;
const jsonLd = [
  { '@type': 'Service', name: area.title, serviceType: '인테리어·공간 사진 및 영상 촬영', areaServed: area.name, provider: { '@id': `${siteConfig.url}/#business` }, url },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Work', item: `${siteConfig.url}/work/` }, { '@type': 'ListItem', position: 2, name: area.title }] },
];
---
<Base title={`${area.title} | 촬영 사례와 진행 방식 — 공간어스`} description={area.description} jsonLd={jsonLd}>
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow" data-reveal>{area.name} / {area.districts.join(' / ')}</p>
      <h1 data-reveal>{area.question}</h1>
      <p class="answer" data-reveal><Sentences text={area.answer} /></p>
      <dl class="facts" data-reveal>
        <div><dt>공간 종류</dt><dd>{[...new Set(works.map((w) => CATEGORIES[w.data.category].label))].join(', ')}</dd></div>
        <div><dt>진행</dt><dd>문의 → 일정 확정 → 촬영(2~4시간) → 5일 이내 납품</dd></div>
        <div><dt>결과물</dt><dd>컷 수 제한 없는 보정 사진, 세로 또는 가로 영상, 사진+영상 패키지</dd></div>
      </dl>
    </div>
    <div class="container related">
      <div class="head"><h2>{area.name} 촬영 사례</h2><a class="link" href="/work/">전체 포트폴리오 →</a></div>
      <WorkGrid works={works} eagerCount={0} />
    </div>
    <div class="container more" data-reveal>
      <p class="eyebrow">관련 가이드</p>
      <ul>
        <li><a href="/guide/cafe-interior-photography/">카페 인테리어 촬영, 언제 어떻게 찍어야 하나요? →</a></li>
        <li><a href="/guide/airbnb-photography/">에어비앤비 숙소 사진, 예약률을 올리려면 →</a></li>
        <li><a href="/guide/interior-photography-cost/">인테리어 촬영 비용은 어떻게 정해지나요? →</a></li>
      </ul>
    </div>
  </section>
  <Cta title={`${area.name} 촬영을 계획 중이라면`} />
</Base>
<style>
  .narrow { max-width: 820px; margin-left: 0; }
  h1 { font-size: clamp(28px, 3.6vw, 52px); }
  .answer { margin-top: 24px; font-size: clamp(17px, 1.4vw, 21px); line-height: 1.75; padding: 24px 0; border-top: 1px solid var(--fg); border-bottom: 1px solid var(--line); }
  .facts { display: grid; gap: 12px; margin: 28px 0 0; font-size: 15px; }
  .facts div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .related { margin-top: clamp(56px, 8vw, 96px); }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .more { margin-top: clamp(48px, 6vw, 80px); }
  .more ul { display: grid; gap: 10px; font-size: 16px; font-weight: 500; }
  @media (max-width: 640px) { .facts div { grid-template-columns: 1fr; gap: 4px; } }
</style>
